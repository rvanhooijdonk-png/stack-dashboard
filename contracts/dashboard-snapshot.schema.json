{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rvanhooijdonk-png/stack-dashboard/contracts/dashboard-snapshot.schema.json",
  "title": "DashboardSnapshotV1",
  "description": "Contract voor de PUBLIEKE snapshot die het dashboard rendert — de gereduceerde DTO uit build.mjs, niet de interne collectoruitvoer. Afgeleid van het Codex-artefact stack-dashboard, uitgebreid met tracker-, vloot- en workstreamsecties en na de review van 23-07-2026 teruggesnoeid: bronpaden en bewijs-URL's staan er bewust NIET in, want deze structuur wordt openbaar gepubliceerd. Elke sectie draagt zijn eigen trust-oordeel; een mislukte bron wordt SOURCE_UNAVAILABLE en nooit een gecachte groene stand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "generatedAt",
    "overallStatus",
    "sources",
    "workstreams",
    "pullRequests",
    "merged",
    "tracker",
    "decisions",
    "fleet",
    "logbook",
    "ci"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "overallStatus": {
      "enum": [
        "OK",
        "DEGRADED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "trust",
          "retrievedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "trust": {
            "$ref": "#/$defs/trust"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "description": "Roadmap-formaat, handmatig vastgelegd. Vervangt de losse handmatige refreshes.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "estimate": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "pullRequests": {
      "type": "object",
      "required": [
        "available",
        "repositories",
        "hiddenRepositories",
        "totals",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "open",
              "draft",
              "ready"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "open": {
                "type": "integer",
                "minimum": 0
              },
              "draft": {
                "type": "integer",
                "minimum": 0
              },
              "ready": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "totals": {
          "type": "object",
          "required": [
            "open",
            "draft",
            "ready"
          ],
          "properties": {
            "open": {
              "type": "integer"
            },
            "draft": {
              "type": "integer"
            },
            "ready": {
              "type": "integer"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "hiddenRepositories": {
          "type": "integer",
          "minimum": 0,
          "description": "Aantal open PR's in repo's die niet bij naam getoond worden (allowlist data/public-repos.json)."
        }
      }
    },
    "merged": {
      "type": "object",
      "required": [
        "available",
        "windowDays",
        "count",
        "byRepository",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "windowDays": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "byRepository": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "merged"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "merged": {
                "type": "integer"
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "tracker": {
      "type": "object",
      "required": [
        "available",
        "updates",
        "decisionPoints",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "title"
            ],
            "properties": {
              "number": {
                "type": "integer"
              },
              "date": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "decisionPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "decisions": {
      "type": "object",
      "required": [
        "available",
        "entries",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "decision"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "fleet": {
      "type": "object",
      "required": [
        "available",
        "tracks",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "track",
              "trust"
            ],
            "properties": {
              "track": {
                "type": "string"
              },
              "lastChangeAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trust": {
                "$ref": "#/$defs/trust"
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "logbook": {
      "type": "object",
      "required": [
        "available",
        "entries",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "ci": {
      "type": "object",
      "required": [
        "available",
        "lights",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "state"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "GROEN",
                  "ROOD",
                  "GRIJS",
                  "GEEN_CI",
                  "ONBEKEND"
                ]
              },
              "at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  },
  "$defs": {
    "trust": {
      "description": "Vertrouwensoordeel per bron. SOURCE_UNAVAILABLE is een geldige eindstand, geen fout die je wegcachet.",
      "enum": [
        "VERIFIED_CURRENT",
        "STALE",
        "UNVERIFIED",
        "SOURCE_UNAVAILABLE",
        "CONFLICTING_EVIDENCE"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "retrievedAt",
        "trust"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trust": {
          "$ref": "#/$defs/trust"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
