{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rvanhooijdonk-png/stack-dashboard/contracts/dashboard-snapshot.schema.json",
  "title": "DashboardSnapshotV2",
  "description": "Contract voor de PUBLIEKE snapshot die het dashboard rendert — de gereduceerde DTO uit build.mjs, niet de interne collectoruitvoer. v2 (23-07-2026, derde review): evidence.source is verwijderd (een bronpad is op een openbare pagina zelf een aanwijzing), tracker draagt twee aparte tekst-vlaggen, en workstream-titel en -raming zijn nullable omdat publicatie per regel expliciet aangezet moet worden. Elke sectie draagt zijn eigen trust-oordeel; een mislukte bron wordt SOURCE_UNAVAILABLE en nooit een gecachte groene stand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "generatedAt",
    "overallStatus",
    "sources",
    "planning",
    "workstreams",
    "pullRequests",
    "merged",
    "tracker",
    "decisions",
    "tracks",
    "logbook",
    "ci",
    "kanaalpost"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "2.4.0",
      "description": "Vastgepind: een DTO die zich niet als exact deze contractversie meldt, hoort niet bij dit schema. Bump dit samen met CONTRACT_VERSION in scripts/build.mjs."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "overallStatus": {
      "enum": [
        "OK",
        "DEGRADED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "trust",
          "retrievedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "trust": {
            "$ref": "#/$defs/trust"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "description": "v2.3: de planning-plaat. Gereduceerde, schoon-gepoorte bouwlijst (TRECHTER levert de rauwe machine-leesbare vorm). `available: false` met reason LEEG/CORRUPT is een geldige fail-closed eindstand — de plaat toont dan een melding en de rest van de pagina blijft staan. Planning staat bewust niet in `sources`: een lege of corrupte bouwlijst degradeert de overall-status niet. v2.4 haalt `kanaalpost` hier weg: die heeft sinds 2.4.0 een eigen sectie met een eigen bron (de publieke spiegel), zodat een lege bouwlijst de post van de hele vloot niet meeneemt. v2.3 voegt de overbrugging toe die TRECHTER's BACKLOG-feed via een vertaler in dit schema laat lopen: `bron` (herkomst van de spiegel), `counters.gepland` en per feature `tier0` + `duurIndicatie`.",
      "required": [
        "available",
        "reason",
        "features",
        "counters",
        "bron"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "description": "Waarom de plaat leeg is; null als hij gevuld is. Gesloten lijst, nooit vrije tekst.",
          "enum": [
            null,
            "LEEG",
            "CORRUPT"
          ]
        },
        "counters": {
          "type": "object",
          "description": "Kop-band: af-sinds-gisteren · draait-nu · wacht-op-Richard · gepland. Puur afgeleid uit de features. `gepland` hoort erbij omdat de eerste drie met een backlog-bron alle drie 0 zijn terwijl er honderden regels wachten — waar, en toch een verkeerd beeld.",
          "required": [
            "afSindsGisteren",
            "draaitNu",
            "wachtOpRichard",
            "gepland"
          ],
          "additionalProperties": false,
          "properties": {
            "afSindsGisteren": {
              "type": "integer",
              "minimum": 0
            },
            "draaitNu": {
              "type": "integer",
              "minimum": 0
            },
            "wachtOpRichard": {
              "type": "integer",
              "minimum": 0
            },
            "gepland": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "status",
              "worker",
              "oplevering",
              "afhankelijkheid",
              "tier0",
              "duurIndicatie"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Publiceerbare naam in gewone taal (gecapt op 120 tekens)."
              },
              "status": {
                "enum": [
                  "gepland",
                  "in-bouw",
                  "in-review",
                  "wacht-op-Richard",
                  "live"
                ],
                "description": "Gesloten woordenschat; een waarde daarbuiten keurt de hele plaat af (harde schoon-poort)."
              },
              "worker": {
                "enum": [
                  null,
                  "worker",
                  "control",
                  "review",
                  "richard"
                ],
                "description": "Neutrale ROL, nooit een account/mail/id (F5 §C). null = nog niet toegewezen."
              },
              "oplevering": {
                "type": "object",
                "description": "Verwachte oplevering, herrekend op het THROUGHPUT-LOG. Geen tweede meetsysteem.",
                "required": [
                  "kind",
                  "date"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "opgeleverd",
                      "verwacht",
                      "onbekend"
                    ]
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "null bij `onbekend`, of een opleverdatum die niet als echte datum kon worden geverifieerd.",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              },
              "afhankelijkheid": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null = geen afhankelijkheid vermeld."
              },
              "tier0": {
                "type": "boolean",
                "description": "Spoedspoor-markering van de bron (`prioriteit_tier === 0`). Alleen een echte `true` markeert; alles anders is geen spoedspoor."
              },
              "duurIndicatie": {
                "enum": [
                  null,
                  "2-4 uur",
                  "1-2 dagen",
                  "3-5 dagen",
                  "1-2 weken"
                ],
                "description": "Eigen startschatting van de bron uit een GESLOTEN lijst. Expliciet géén tweede meetsysteem: wordt nergens naar een datum herrekend en raakt het THROUGHPUT-LOG niet. null = de bron leverde geen indicatie."
              }
            }
          }
        },
        "bron": {
          "type": [
            "object",
            "null"
          ],
          "description": "Herkomst van de bouwlijst. De plaat leest niet de bron zelf maar een SPIEGEL op de rapporten-branch van stack-control (het bewezen-leesbare afleverkanaal), dus de pagina moet dat zichtbaar zeggen — anders leest een verouderde spiegel als actuele stand. null = een §B-bron zonder spiegel-provenance.",
          "required": [
            "sha",
            "bouwbaar",
            "publishVeilig",
            "weggelaten",
            "spiegelAt"
          ],
          "additionalProperties": false,
          "properties": {
            "sha": {
              "type": [
                "string",
                "null"
              ],
              "description": "Korte commit-sha van de bron-meetlat; null als de bron er geen leverde.",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "bouwbaar": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "publishVeilig": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "weggelaten": {
              "type": "integer",
              "minimum": 0,
              "description": "Aantal regels dat de per-regel schoon-poort van de vertaler liet vallen. Geteld, nooit stil weggelaten."
            },
            "spiegelAt": {
              "type": [
                "string",
                "null"
              ],
              "description": "ISO-tijdstempel van de laatste wijziging van de spiegel; null = onbekend, en onbekend is niet vers."
            }
          }
        }
      }
    },
    "kanaalpost": {
      "type": "object",
      "description": "v2.4: de vloot-kanaalpost, gelezen uit de publieke spiegel `data/kanaalpost-publiek.md` in deze repo — niet uit het interne logboek. Laatste vijftien rijen, nieuwste boven. `available: false` met reason BRON_ONBEREIKBAAR/LEEG/INGEHOUDEN is een geldige fail-closed eindstand; net als planning staat deze sectie bewust niet in `sources`. De rijvelden zijn sinds de dubbele review niet meer nullable: corrupte invoer wordt ingehouden en geteld, niet als geldige rij vol streepjes gepubliceerd. `ingehouden` telt ÁLLE rijen van de spiegel die niet door vorm- of publicatiepoort kwamen, niet alleen die binnen het venster van vijftien — anders zou 0 een geruststelling zijn die niets bewijst. Wat het schema niet kan afdwingen (de validator kent geen if/then, maxItems of maxLength): dat `available: true` een niet-lege rows impliceert en `available: false` een lege. De converter bewaakt dat, met tests erop.",
      "required": [
        "available",
        "reason",
        "rows",
        "ingehouden"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "BRON_ONBEREIKBAAR",
            "LEEG",
            "INGEHOUDEN",
            null
          ],
          "description": "Waarom de sectie leeg is; null als hij gevuld is. Gesloten lijst, nooit vrije tekst."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tab",
              "onderwerp",
              "status",
              "actie",
              "datum"
            ],
            "additionalProperties": false,
            "properties": {
              "tab": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:[ -][A-Z0-9]+)*$",
                "description": "Neutraal rollabel van het meldende werkvenster, in kapitalen (CONTROL, COMMAND-CANON). Geen persoon en geen repository: repo-namen zijn kleingeschreven en vallen buiten dit patroon. Een rij met een afwijkend label wordt ingehouden en geteld, niet stil weggelaten."
              },
              "onderwerp": {
                "type": "string",
                "description": "Wat er gebeurd is, in gewone taal. Al voor publiek geschreven in de spiegel en hier nogmaals langs de publish-poort; afgekapt op 600 tekens met een zichtbare `…`. Nooit null: een rij zonder onderwerp is geen rij en wordt ingehouden (review Codex, 26-07-2026)."
              },
              "status": {
                "enum": [
                  "AFGEROND",
                  "WACHT OP AKKOORD",
                  "GEBLOKKEERD"
                ],
                "description": "Gesloten lijst uit de kop van de spiegel zelf. De beschrijving wás de enige plek waar die lijst stond; nu dwingt het contract hem af."
              },
              "actie": {
                "type": "string",
                "description": "Wie aan zet is. Wordt in de statuskolom getoond, niet in een eigen kolom."
              },
              "datum": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$",
                "description": "Dagdatum, eventueel met tijd (Europe/Amsterdam), altijd tweecijferig. Ook deze cel gaat door de publish-poort."
              }
            }
          }
        },
        "ingehouden": {
          "type": "integer",
          "minimum": 0,
          "description": "Aantal rijen dat de publicatie-poort niet haalde. Zichtbaar op de plaat: inhouden mag, stilzwijgend inhouden niet."
        }
      }
    },
    "workstreams": {
      "type": "array",
      "description": "Roadmap-formaat uit data/workstreams.json. Titel en raming verschijnen alleen als die regel `public: true` draagt en de raming een duur is; anders null.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "estimate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}$",
            "description": "Alleen het workstreamnummer. Elke andere waarde breekt de build — een id was een publicatieroute langs public:true heen."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "null = regel niet vrijgegeven voor publicatie."
          },
          "estimate": {
            "type": [
              "string",
              "null"
            ],
            "description": "null = niet vrijgegeven of geen geldige duur."
          }
        },
        "additionalProperties": false
      }
    },
    "pullRequests": {
      "type": "object",
      "required": [
        "available",
        "repositories",
        "hiddenRepositories",
        "totals",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "open",
              "draft",
              "ready"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "open": {
                "type": "integer",
                "minimum": 0
              },
              "draft": {
                "type": "integer",
                "minimum": 0
              },
              "ready": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "totals": {
          "type": "object",
          "required": [
            "open",
            "draft",
            "ready"
          ],
          "properties": {
            "open": {
              "type": "integer"
            },
            "draft": {
              "type": "integer"
            },
            "ready": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "hiddenRepositories": {
          "type": "integer",
          "minimum": 0,
          "description": "Aantal open PR's in repo's die niet bij naam getoond worden (allowlist data/public-repos.json)."
        }
      },
      "additionalProperties": false
    },
    "merged": {
      "type": "object",
      "required": [
        "available",
        "windowDays",
        "count",
        "byRepository",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "windowDays": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "byRepository": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "merged"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "merged": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "tracker": {
      "type": "object",
      "required": [
        "available",
        "updates",
        "decisionPoints",
        "evidence",
        "updatesTextWithheld",
        "decisionPointsTextWithheld"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "date",
              "title"
            ],
            "properties": {
              "number": {
                "type": "integer"
              },
              "date": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null = tekst ingehouden (data/publish-text.json)."
              }
            },
            "additionalProperties": false
          }
        },
        "decisionPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "category"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null = tekst ingehouden (data/publish-text.json)."
              },
              "category": {
                "$ref": "#/$defs/category"
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "updatesTextWithheld": {
          "type": "boolean"
        },
        "decisionPointsTextWithheld": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "required": [
        "available",
        "entries",
        "evidence",
        "textWithheld"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "date",
              "decision",
              "category"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "decision": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null = tekst ingehouden (data/publish-text.json)."
              },
              "category": {
                "$ref": "#/$defs/category"
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "textWithheld": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "object",
      "description": "v2.1: per allowlist-track de leeftijd van het meest recente klaar-rapport (CONTROL/RAPPORTEN op branch rapporten). Vervangt de oude vloot (commitdatum queue-bestand). Alleen de allowlist-tracks verschijnen; er is geen hiddenTracks-telling omdat we niet over de rapportenmap itereren maar per bekende track tellen. Een track zonder rapport draagt lastReportAt: null en trust UNVERIFIED.",
      "required": [
        "available",
        "tracks",
        "evidence"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "track",
              "lastReportAt",
              "reportCount",
              "trust"
            ],
            "properties": {
              "track": {
                "type": "string"
              },
              "lastReportAt": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null = geen klaar-rapport gevonden voor deze track (geen bewijs van werk).",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})$"
              },
              "reportCount": {
                "type": "integer",
                "minimum": 0
              },
              "trust": {
                "$ref": "#/$defs/trust"
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "logbook": {
      "type": "object",
      "required": [
        "available",
        "entries",
        "evidence",
        "textWithheld"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null = tekst ingehouden (data/publish-text.json)."
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "textWithheld": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "required": [
        "available",
        "lights",
        "evidence",
        "hiddenCiRepositories"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "state",
              "at"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "GROEN",
                  "ROOD",
                  "GRIJS",
                  "GEEN_CI",
                  "ONBEKEND"
                ]
              },
              "at": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})$"
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "hiddenCiRepositories": {
          "type": "integer",
          "minimum": 0,
          "description": "Aantal CI-repo's dat niet bij naam getoond wordt (allowlist data/public-repos.json)."
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "trust": {
      "description": "Vertrouwensoordeel per bron. SOURCE_UNAVAILABLE is een geldige eindstand, geen fout die je wegcachet.",
      "enum": [
        "VERIFIED_CURRENT",
        "STALE",
        "UNVERIFIED",
        "SOURCE_UNAVAILABLE",
        "CONFLICTING_EVIDENCE"
      ]
    },
    "category": {
      "description": "Afgeleid categorielabel op een besluit of beslispunt (categoriseer() in scripts/lib/collect.mjs). Gesloten woordenschat; nooit brontekst. 'overig' is de expliciete restklasse, geen fout.",
      "enum": [
        "security",
        "accounts",
        "kosten",
        "merge-beleid",
        "planning",
        "overig"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "retrievedAt",
        "trust",
        "errorCode"
      ],
      "additionalProperties": false,
      "properties": {
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trust": {
          "$ref": "#/$defs/trust"
        },
        "errorCode": {
          "description": "Gesloten codelijst; nooit de fouttekst van een collector. Zie ERROR_CODE_BY_TRUST in scripts/build.mjs.",
          "enum": [
            null,
            "VEROUDERD",
            "NIET_GEVERIFIEERD",
            "BRON_ONBEREIKBAAR",
            "TEGENSTRIJDIG",
            "ONBEKEND"
          ]
        }
      }
    }
  }
}
